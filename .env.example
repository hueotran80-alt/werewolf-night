# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SERVER_URL: Địa chỉ máy chủ trung gian (cloud relay) đã triển khai,
# ví dụ Render/Railway/Fly.io. Đặt biến này TRƯỚC khi chạy `npm run build`
# để "đóng đinh" sẵn máy chủ vào bản APK Android phát hành - người chơi cài
# app xong dùng được luôn, không cần tự nhập trong Cài Đặt.
# Có thể ghi kèm https:// hoặc để trơn domain, ví dụ:
#   VITE_SERVER_URL="ten-server-cua-ban.onrender.com"
# Nếu để trống, người dùng có thể tự nhập địa chỉ máy chủ trong màn hình
# Cài Đặt của app sau khi cài đặt xong.
VITE_SERVER_URL=""
